Activate the most recently used tab when the active tab is closed, instead of
the adjacent tab. Falls back to the original Chromium behavior (opener-based,
then adjacent) when no MRU candidate has a valid last-active timestamp (e.g.
during session restore).

--- a/chrome/browser/ui/tabs/tab_strip_model.cc	2026-06-01 14:37:24
+++ b/chrome/browser/ui/tabs/tab_strip_model.cc	2026-06-01 14:37:41
@@ -35,6 +35,7 @@
 #include "base/notreached.h"
 #include "base/observer_list.h"
 #include "base/trace_event/common/trace_event_common.h"
+#include "base/time/time.h"
 #include "base/trace_event/trace_event.h"
 #include "base/types/pass_key.h"
 #include "build/build_config.h"
@@ -5363,6 +5364,29 @@
   }
 
   gfx::Range block_tabs = gfx::Range(start_index, start_index + block_size);
+
+  // Helium: prefer activating the most recently used tab.
+  {
+    base::TimeTicks best_time;
+    int best_index = -1;
+    for (int i = 0; i < count(); ++i) {
+      if (block_tabs.Contains(gfx::Range(i, i + 1))) {
+        continue;
+      }
+      content::WebContents* contents = GetWebContentsAt(i);
+      if (!contents) {
+        continue;
+      }
+      base::TimeTicks last_active = contents->GetLastActiveTimeTicks();
+      if (last_active > best_time) {
+        best_time = last_active;
+        best_index = i;
+      }
+    }
+    if (best_index >= 0 && best_time > base::TimeTicks()) {
+      return GetTabIndexAfterClosing(best_index, block_tabs);
+    }
+  }
 
   // First preference is a tab the block opened.
   int new_selected_index = GetIndexOfNextWebContentsOpenedBy(block_tabs);
