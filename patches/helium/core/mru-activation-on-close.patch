Activate the most recently used tab when the active tab is closed, instead of
the adjacent tab. Falls back to the original Chromium behavior (opener-based,
then adjacent) when no MRU candidate has a valid last-active timestamp (e.g.
during session restore).

Ported to chromium 153: DetermineNewSelectedIndex moved from
TabStripModelOrderController (tab_strip_model_order_controller.cc, removed) onto
TabStripModel (tab_strip_model.cc) and now takes a tab/collection variant with a
computed `block_tabs` range instead of a single removing_index.

--- a/chrome/browser/ui/tabs/tab_strip_model.cc
+++ b/chrome/browser/ui/tabs/tab_strip_model.cc
@@ -5863,6 +5863,31 @@ std::optional<int> TabStripModel::DetermineNewSelectedIndex(
   }
 
   gfx::Range block_tabs = gfx::Range(start_index, start_index + block_size);
 
+  // Helium: prefer the most-recently-used tab outside the closing block. Falls
+  // back to the original opener/adjacent logic below when no candidate has a
+  // valid last-active timestamp (e.g. during session restore).
+  {
+    base::TimeTicks best_time;
+    int best_index = TabStripModel::kNoTab;
+    for (int i = 0; i < count(); ++i) {
+      if (block_tabs.Contains(gfx::Range(i)) || IsTabCollapsed(i)) {
+        continue;
+      }
+      content::WebContents* contents = GetWebContentsAt(i);
+      if (!contents) {
+        continue;
+      }
+      base::TimeTicks last_active = contents->GetLastActiveTimeTicks();
+      if (last_active > best_time) {
+        best_time = last_active;
+        best_index = i;
+      }
+    }
+    if (best_index != TabStripModel::kNoTab && best_time > base::TimeTicks()) {
+      return GetTabIndexAfterClosing(best_index, block_tabs);
+    }
+  }
+
   // First preference is a tab the block opened.
   int new_selected_index = GetIndexOfNextWebContentsOpenedBy(block_tabs);
